module lab4_TB;

wire START_PERMIT, CHIME, WARN_PRI2, WARN_PRI1;
wire SEAT_WARN, DOOR_WARN, HOOD_WARN, TRUNK_WARN;
wire BAT_WARN, AIRBAG_WARN, TEMP_WARN;

reg SB, DOOR, KEY, BRK, PARK, HOOD;
reg BAT_OK, AIB_OK, TMP_OK;
reg PASS_OCC, SB_P, TRUNK, PBRK, SRV;


// Device Under Test
Top uut (
    SB, DOOR, KEY, BRK, PARK, HOOD,
    BAT_OK, AIB_OK, TMP_OK,
    PASS_OCC, SB_P, TRUNK, PBRK, SRV,
    START_PERMIT, CHIME, WARN_PRI2, WARN_PRI1,
    SEAT_WARN, DOOR_WARN, HOOD_WARN, TRUNK_WARN,
    BAT_WARN, AIRBAG_WARN, TEMP_WARN
);


initial begin

    // ============================================================
    // NORMAL / SAFE STATE
    // ============================================================
    SB       = 1'b1;
    DOOR     = 1'b1;
    KEY      = 1'b0;
    BRK      = 1'b0;
    PARK     = 1'b1;
    HOOD     = 1'b1;
    BAT_OK   = 1'b1;
    AIB_OK   = 1'b1;
    TMP_OK   = 1'b1;
    PASS_OCC = 1'b0;
    SB_P     = 1'b1;
    TRUNK    = 1'b1;
    PBRK     = 1'b1;
    SRV      = 1'b0;

    #10;


    // ============================================================
    // TEST 1: CHIME
    // CHIME = KEY
    // ============================================================
    KEY = 1'b1;
    #10;
    KEY = 1'b0;
    #10;


    // ============================================================
    // TEST 2: DRIVER SEATBELT WARNING
    // SEAT_WARN = ~SB | (PASS_OCC & ~SB_P)
    // ============================================================
    SB = 1'b0;
    #10;
    SB = 1'b1;
    #10;


    // ============================================================
    // TEST 3: PASSENGER SEATBELT WARNING
    // ============================================================
    PASS_OCC = 1'b1;
    SB_P = 1'b0;
    #10;

    PASS_OCC = 1'b0;
    SB_P = 1'b1;
    #10;


    // ============================================================
    // TEST 4: DOOR WARNING
    // DOOR_WARN = ~DOOR
    // ============================================================
    DOOR = 1'b0;
    #10;
    DOOR = 1'b1;
    #10;


    // ============================================================
    // TEST 5: HOOD WARNING
    // HOOD_WARN = ~HOOD
    // ============================================================
    HOOD = 1'b0;
    #10;
    HOOD = 1'b1;
    #10;


    // ============================================================
    // TEST 6: TRUNK WARNING
    // TRUNK_WARN = ~TRUNK
    // ============================================================
    TRUNK = 1'b0;
    #10;
    TRUNK = 1'b1;
    #10;


    // ============================================================
    // TEST 7: BATTERY WARNING
    // BAT_WARN = ~BAT_OK
    // ============================================================
    BAT_OK = 1'b0;
    #10;
    BAT_OK = 1'b1;
    #10;


    // ============================================================
    // TEST 8: AIRBAG WARNING
    // AIRBAG_WARN = ~AIB_OK
    // ============================================================
    AIB_OK = 1'b0;
    #10;
    AIB_OK = 1'b1;
    #10;


    // ============================================================
    // TEST 9: TEMPERATURE WARNING
    // TEMP_WARN = ~TMP_OK
    // ============================================================
    TMP_OK = 1'b0;
    #10;
    TMP_OK = 1'b1;
    #10;


    // ============================================================
    // TEST 10: PRIORITY 2 WARNING - DOOR
    // WARN_PRI2 = KEY & ~PARK &
    //             (~TRUNK | ~HOOD | ~DOOR)
    // ============================================================
    KEY  = 1'b1;
    PARK = 1'b0;
    DOOR = 1'b0;
    #10;

    DOOR = 1'b1;
    KEY  = 1'b0;
    PARK = 1'b1;
    #10;


    // ============================================================
    // TEST 11: PRIORITY 1 WARNING - BATTERY
    // WARN_PRI1 = KEY & ~PARK &
    //             (~BAT_OK | ~TMP_OK | ~AIB_OK)
    // ============================================================
    KEY    = 1'b1;
    PARK   = 1'b0;
    BAT_OK = 1'b0;
    #10;

    BAT_OK = 1'b1;
    KEY    = 1'b0;
    PARK   = 1'b1;
    #10;


    // ============================================================
    // TEST 12: START PERMIT
    // START_PERMIT = ~SRV & KEY & BRK & PARK & BAT_OK
    // ============================================================
    SRV    = 1'b0;
    KEY    = 1'b1;
    BRK    = 1'b1;
    PARK   = 1'b1;
    BAT_OK = 1'b1;
    #10;


    // ============================================================
    // TEST 13: START BLOCKED BY SERVICE MODE
    // ============================================================
    SRV = 1'b1;
    #10;


    $stop;

end

endmodule



